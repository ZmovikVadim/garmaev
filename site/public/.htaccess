# Сайт памяти Р. Б. Гармаева. Правила Apache для шаред-хостинга Reg.ru.
#
# Файл попадает в сборку сам: всё из public/ копируется в dist/. Он скрытый —
# имя начинается с точки. В Finder показывается по Cmd+Shift+точка, в терминале
# через `ls -la`. При заливке по FTP убедитесь, что клиент его не пропустил:
# без этого файла сайт работает, но без принудительного https, без редиректа
# с www, без страницы 404 и без кэширования.

AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# Файл состояния FTP-синхронизации GitHub Actions лежит в корне сайта и
# перечисляет все файлы — наружу его отдавать незачем.
<Files ".ftp-deploy-sync-state.json">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ВНИМАНИЕ: блок принудительного https выключен намеренно.
  #
  # Включайте его ТОЛЬКО после того, как для домена выпущен сертификат
  # Let's Encrypt. Пока на хостинге стоит самоподписанный сертификат-заглушка,
  # принудительный https означает предупреждение браузера о недоверенном
  # сертификате у каждого посетителя.
  #
  # Как включить: уберите знаки # с трёх строк ниже и залейте файл заново.
  # Или включите перенаправление на https в панели Reg.ru — тогда правило
  # здесь не нужно вовсе.
  #
  # RewriteCond %{HTTPS} !=on
  # RewriteCond %{HTTP:X-Forwarded-Proto} !https
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Один канонический адрес: без www. Схема сохраняется через REQUEST_SCHEME,
  # чтобы до выпуска Let's Encrypt не отправлять посетителя на https
  # с самоподписанным сертификатом.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Astro подмешивает хэш в имена файлов сборки, поэтому их можно кэшировать
  # надолго: при изменении меняется имя.
  <FilesMatch "\.(css|js)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # Снимки не меняются, но имена у них постоянные — месяц.
  <FilesMatch "\.(jpe?g|png|webp|avif|svg|ico)$">
    ExpiresDefault "access plus 1 month"
  </FilesMatch>

  # Страницы должны обновляться быстро после заливки.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 10 minutes"
  </FilesMatch>
</IfModule>
