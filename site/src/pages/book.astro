---
import Base from '../layouts/Base.astro'
import site from '../data/site.json'
import { withBase } from '../lib/url'

/**
 * Раздел-заглушка. Когда появится скан, положите файлы в public/book/
 * и заполните downloads — кнопки появятся сами.
 */
const downloads: { label: string; href: string; note: string }[] = []

const heroes = [
  'Гуржап Очиров — командир партизанской бригады на Смоленщине',
  'Владимир Борсоев — Герой Советского Союза, полковник',
  'Гунсын Цыденова — государственный деятель',
  'Григорий Москалев — заслуженный художник России',
  'Антон Занданов — генерал-майор медицинской службы',
  'Содном Дамбаев — разведчик ГРУ, участник афганской войны',
  'Иван Пилипенко — подполковник в запасе',
  'Дугаржап Дашиев, Ким Базарсадаев, Владимир Буруев, Саян Раднаев — оперные певцы',
  'Матвей Чойбонов, Даши Дамбаев — писатели и поэты',
]
---

<Base
  title="Книга"
  description="«Дорогие моему сердцу имена» — книга Ревомира Гармаева, 2013 год: статьи, очерки, эссе и воспоминания на бурятском и русском языках."
>
  <div class="wrap">
    <main>
      <p class="eyebrow">2013 год</p>
      <h1>«Дорогие моему сердцу имена»</h1>

      <div class="prose">
        <p class="lede">
          Книга, которую он собрал сам: статьи, очерки, эссе и воспоминания, написанные в
          разные годы, на бурятском и русском языках. История республики в судьбах
          конкретных людей.
        </p>

        <blockquote>
          Я выражаю огромную надежду, что герои моих очерков — воины Великой Отечественной,
          труженики тыла, восстановившие народное хозяйство, мои современники —
          политические и культурные деятели республики — послужат молодому поколению
          ориентиром в правильном выборе жизненного пути.
          <cite>На презентации книги, февраль 2013</cite>
        </blockquote>

        <p>
          Презентация прошла в канун Дня защитника Отечества 2013 года в Республиканском
          детско-юношеском центре туризма и краеведения — на финале конференции школьников
          «С рюкзаком по родному краю». Школьники приехали со всех районов республики.
          Вместе с автором на встречу пришли и герои его очерков: Иван Пилипенко и Содном
          Дамбаев, который рассказал ребятам, как стал военным разведчиком.
        </p>

        <h2>О ком эта книга</h2>
      </div>

      <ul class="awards">
        {heroes.map((hero) => <li>{hero}</li>)}
      </ul>

      <div class="prose">
        <h2>Скачать</h2>
      </div>

      {
        downloads.length > 0 ? (
          <nav class="cards" aria-label="Скачать книгу">
            {downloads.map((file) => (
              <a class="card" href={withBase(file.href)} download>
                <span class="card__title">{file.label}</span>
                <p class="card__note">{file.note}</p>
              </a>
            ))}
          </nav>
        ) : (
          <div class="note">
            <p>
              <strong>Скан книги готовится.</strong> Когда он будет готов, здесь появятся
              файлы для чтения и скачивания — PDF с изображениями страниц и FB2 с
              распознанным текстом для читалок и телефонов.
            </p>
            <p>
              Если у вас есть бумажный экземпляр и вы готовы помочь со сканированием —
              напишите {site.contactName}:{' '}
              <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>.
            </p>
          </div>
        )
      }

      <div class="prose">
        <hr />
        <p class="card__note">
          Источники: «Информ Полис», 26 февраля 2013; «Байкал-Daily», 15 октября 2013.
          Ссылки — в разделе <a href={withBase('/articles')}>«Статьи»</a>.
        </p>
      </div>
    </main>
  </div>
</Base>
