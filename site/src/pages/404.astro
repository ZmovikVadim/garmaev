---
import Base from '../layouts/Base.astro'
import { withBase } from '../lib/url'
import site from '../data/site.json'
---

<Base title="Страница не найдена" description="Такой страницы на сайте нет.">
  <div class="wrap">
    <main>
      <p class="eyebrow">Ошибка 404</p>
      <h1>Такой страницы нет</h1>

      <div class="prose">
        <p class="lede">
          Возможно, ссылка устарела или в адресе опечатка. Вот куда можно пойти отсюда.
        </p>
      </div>

      <nav class="cards cards--four" aria-label="Разделы сайта">
        {
          site.nav
            .filter((item) => item.href !== '/')
            .slice(0, 4)
            .map((item) => (
              <a class="card" href={withBase(item.href)}>
                <span class="card__title">{item.label}</span>
              </a>
            ))
        }
      </nav>

      <div class="prose">
        <p><a href={withBase('/')}>← На главную страницу</a></p>
      </div>
    </main>
  </div>
</Base>
